<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện cuộc gọi: thiết kế y hệt Google Phone / giao diện gọi hệ thống Android.
     Nền xám nhạt (incall_bg), bố cục dọc 3 vùng:
       1. Header: thông tin người gọi (avatar + tên + số + trạng thái + đồng hồ)
       2. Giữa: 4 nút hành động (Loa / Tắt mic / Phím bấm / Thêm)
       3. Footer: nút Kết thúc đỏ tròn to giữa màn                            -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootIncall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incall_bg"
    android:fitsSystemWindows="false">

    <!-- ───────── VÙNG TRÊN: thông tin người gọi ───────── -->

    <!-- Avatar tròn lớn (chữ cái đầu tên hoặc ic mặc định) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_person_default"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleShape" />

        <TextView
            android:id="@+id/tvAvatarLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_avatar_incall"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Tên người gọi -->
    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Số điện thoại (hiện khi đã có tên; ẩn khi chỉ có số) -->
    <TextView
        android:id="@+id/tvCallerNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvCallerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trạng thái: "Đang gọi…" / "Đang đổ chuông…" / "Đã kết nối" -->
    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvCallerNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Đồng hồ thời gian cuộc gọi (hiện sau khi kết nối) -->
    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvCallStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ───────── VÙNG GIỮA: 4 nút hành động ───────── -->

    <GridLayout
        android:id="@+id/gridActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/chronometer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llAnswerReject"
        app:layout_constraintVertical_bias="0.5">

        <!-- Ghi âm: hiển thị trạng thái tự động ghi âm cuộc gọi (bật/tắt ở Cài đặt) - KHÔNG tự
             mở MediaRecorder riêng tại đây, vì app đã có CallRecordingService chạy nền tự ghi âm
             theo trạng thái cuộc gọi hệ thống; nếu bấm nút này cũng tự mở 1 MediaRecorder khác
             cùng lúc, 2 bên sẽ tranh nhau nguồn ghi âm cuộc gọi và một bên sẽ lỗi/im lặng. -->
        <LinearLayout
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivRecord"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_record_dot"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:id="@+id/tvRecordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_recording"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Tắt mic -->
        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_mic"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tắt mic"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Giữ máy -->
        <LinearLayout
            android:id="@+id/btnHold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivHold"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_pause"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giữ máy"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Gọi rõ ràng: khử tiếng ồn bằng NoiseSuppressor chuẩn Android. Hiệu quả tuỳ máy -
             nhiều máy đường tiếng cuộc gọi đi qua modem, app không can thiệp trực tiếp được. -->
        <LinearLayout
            android:id="@+id/btnClarity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivClarity"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_call_clarity"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/call_clarity"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Thêm cuộc gọi: app chỉ quản lý 1 cuộc gọi tại 1 thời điểm (chưa hỗ trợ ghép/giữ
             nhiều cuộc gọi cùng lúc an toàn) - báo rõ thay vì giả vờ hoạt động. -->
        <LinearLayout
            android:id="@+id/btnAddCall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_call"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Thêm: tuỳ chọn khác, chưa xây dựng đầy đủ. -->
        <LinearLayout
            android:id="@+id/btnMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_expand_more"
                android:background="@drawable/bg_action_btn"
                android:padding="14dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_options"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </GridLayout>

    <!-- ───────── VÙNG DƯỚI: nút Trả lời / Từ chối / Kết thúc ───────── -->

    <LinearLayout
        android:id="@+id/llAnswerReject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="48dp"
        android:paddingHorizontal="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Loa ngoài: CHỈ hiện khi đang DIALING/ACTIVE (ẩn lúc RINGING, cùng lúc với
             gridActions) - dùng chung mẹo weight với spacerMiddle/btnAnswerWrap bên dưới: 1
             LinearLayout GONE không cộng vào tổng weight của hàng, nên khi ẩn 2 trong 3 ô có
             weight, ô còn lại tự động chiếm hết bề rộng còn thiếu - nhờ vậy Kết thúc tự động ở
             giữa lúc active, và Từ chối/Trả lời tự dàn 2 bên lúc đang đổ chuông, dùng đúng 1
             layout duy nhất cho cả 2 trường hợp. -->
        <LinearLayout
            android:id="@+id/btnSpeakerWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:id="@+id/ivSpeaker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_volume_up"
                android:background="@drawable/bg_action_btn"
                android:padding="12dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Loa ngoài" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loa ngoài"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Từ chối / Kết thúc (luôn hiện) -->
        <LinearLayout
            android:id="@+id/btnDeclineWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnDecline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call_end"
                android:background="@drawable/bg_btn_decline_circle"
                android:padding="18dp"
                android:tint="@color/white"
                android:contentDescription="Từ chối / Kết thúc" />
            <TextView
                android:id="@+id/tvDeclineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Từ chối"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Khoảng giữa (chỉ hiện khi có cuộc gọi đến — để 2 nút cân bằng) -->
        <Space
            android:id="@+id/spacerMiddle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Trả lời (chỉ hiện khi cuộc gọi đến) -->
        <LinearLayout
            android:id="@+id/btnAnswerWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/btnAnswer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/bg_btn_answer_circle"
                android:padding="18dp"
                android:tint="@color/white"
                android:contentDescription="Trả lời" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trả lời"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Phím bấm: CHỈ hiện khi đang DIALING/ACTIVE, cùng cơ chế weight như Loa ở trên. -->
        <LinearLayout
            android:id="@+id/btnDialpadWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:id="@+id/ivDialpad"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_dialpad"
                android:background="@drawable/bg_action_btn"
                android:padding="12dp"
                android:tint="@color/text_primary"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bàn phím" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phím bấm"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Phím bấm DTMF (ẩn mặc định, hiện khi bấm nút Phím bấm) -->
    <LinearLayout
        android:id="@+id/dialpadOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/incall_bg"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDtmfInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.15"
            android:hint="..."
            android:textColorHint="@color/text_hint" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/dtmf1"  style="@style/DtmfKey" android:text="1\n " />
            <Button android:id="@+id/dtmf2"  style="@style/DtmfKey" android:text="2\nABC" />
            <Button android:id="@+id/dtmf3"  style="@style/DtmfKey" android:text="3\nDEF" />
            <Button android:id="@+id/dtmf4"  style="@style/DtmfKey" android:text="4\nGHI" />
            <Button android:id="@+id/dtmf5"  style="@style/DtmfKey" android:text="5\nJKL" />
            <Button android:id="@+id/dtmf6"  style="@style/DtmfKey" android:text="6\nMNO" />
            <Button android:id="@+id/dtmf7"  style="@style/DtmfKey" android:text="7\nPQRS" />
            <Button android:id="@+id/dtmf8"  style="@style/DtmfKey" android:text="8\nTUV" />
            <Button android:id="@+id/dtmf9"  style="@style/DtmfKey" android:text="9\nWXYZ" />
            <Button android:id="@+id/dtmfStar" style="@style/DtmfKey" android:text="*\n " />
            <Button android:id="@+id/dtmf0"  style="@style/DtmfKey" android:text="0\n+" />
            <Button android:id="@+id/dtmfHash" style="@style/DtmfKey" android:text="#\n " />
        </GridLayout>

        <Button
            android:id="@+id/btnHideDialpad"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:text="Ẩn phím bấm"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
